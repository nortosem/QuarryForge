[run]
branch = True
source = quarryforge, tests
omit = 
    */__init__.py
    */venv/*
    */test_venv/*

[report]
show_missing = True
skip_covered = False
precision = 2
exclude_lines = 
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__:
    @(abc\.)?abstractmethod
    ^\s*pass\s*$

[html]
skip_empty = True
skip_covered = False
directory = coverage_report 

#coverage html --no-skip-covered --precision=2 --skip-empty
#coverage run --branch --source quarryforge/ -m pytest tests

